# MySQL connection string (required). Create the database first:
#   CREATE DATABASE bookmarks CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DATABASE_URL="mysql://username:password@localhost:3306/bookmarks"

# Don't set PORT here: it would also move `pnpm dev` off 3000. The production
# port (8008) is set by scripts/start.ps1 (see README).

# Name shown in the header and browser tab (optional, default "Bookmarks").
# Build-time: restart dev / rebuild after changing it.
# VITE_APP_NAME="Bookmarks"
